# На Vercel обязательно задать все переменные в Project Settings → Environment Variables
# и сделать Redeploy. Без этого вход не сработает.

# Turso (libsql://....turso.io)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Секрет подписи JWT (случайная длинная строка)
JWT_SECRET=

# Первый администратор создаётся сам при первом запросе к базе
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# Секрет для заявок с сайта: POST /api/leads/inbound
CRM_INBOUND_SECRET=
