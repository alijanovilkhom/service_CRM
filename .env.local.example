# Локально: file:crm.db. В продакшене — URL Turso (libsql://...)
TURSO_DATABASE_URL=file:crm.db
TURSO_AUTH_TOKEN=

# Секрет подписи JWT (случайная длинная строка)
JWT_SECRET=replace-with-a-long-random-secret

# Первый администратор — создаётся скриптом npm run seed
ADMIN_EMAIL=admin@crm.local
ADMIN_PASSWORD=changeme
ADMIN_NAME=Администратор

# Секрет для заявок с сайта: POST /api/leads/inbound
CRM_INBOUND_SECRET=replace-with-a-long-random-secret
